name: Deploy to Pages Branch

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout your repository using git
        uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          
      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9.14.4
          run_install: false
          
      # 安装根目录依赖（Mizuki）
      - name: Install root dependencies
        run: pnpm install --no-frozen-lockfile
      
      # 安装 Butterfly 子项目依赖（Hexo）
      - name: Install Butterfly dependencies
        working-directory: ./classic
        run: npm install
      
      # 构建双站（同步 + 构建 + 合并）
      - name: Build site
        run: pnpm run deploy-all
      
      # 部署到 pages 分支
      - name: Deploy to pages branch
        uses: JamesIves/github-pages-deploy-action@v4
        with:
          branch: pages
          folder: dist
          clean: true